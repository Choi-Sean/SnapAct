# Backend
backend/.env
backend/__pycache__/
backend/app/__pycache__/
backend/venv/
backend/.venv/
# Private key material only — the .cer certificates themselves are public
# and needed at runtime (AppleWWDRCAG4.cer, pass.cer), so they stay tracked.
backend/app/certs/*.p12
backend/app/certs/*.pem
backend/app/certs/*.csr
backend/app/data/
backend/*.json
backend/secrets/

# Mobile / Node
apps/expo/node_modules/
apps/expo/.expo/
apps/expo/dist/
apps/expo/npm-debug.*
apps/expo/*.log
apps/expo/secrets/

# iOS native (apps/ios/) — Xcode user state and build products
apps/ios/**/*.xcuserstate
apps/ios/**/xcuserdata/
apps/ios/**/DerivedData/
apps/ios/**/build/
apps/ios/**/Pods/

web/node_modules/
web/.next/
web/next-env.d.ts
web/tsconfig.tsbuildinfo

# OS
.DS_Store
Thumbs.db

