# Anthropic (Claude) API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Vision — path to a service-account JSON key file
# https://console.cloud.google.com/apis/credentials
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: override the Claude model
CLAUDE_MODEL=claude-sonnet-5

# Shared secret the mobile app must send as the X-API-Key header.
# Prevents random people who find the Railway URL from burning your API budget.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_SHARED_SECRET=

# Apple Wallet (.pkpass) signing — from a "Pass Type ID" certificate you create
# yourself at developer.apple.com (Certificates, Identifiers & Profiles > Identifiers
# > Pass Type IDs), then export the cert+key together as a .p12 from Keychain Access.
PASS_CERT_P12_PATH=./app/certs/pass.p12
PASS_CERT_P12_PASSWORD=
